{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG KUBECTL_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG K9S_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "derailed/k9s",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG HELM_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG ARGOCD_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG ETCD_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "etcd-io/etcd",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG CRICTL_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "kubernetes-sigs/cri-tools",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG YQ_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG NEOVIM_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "neovim/neovim",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ARG DIAGRAMS_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "diagrams",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ansible==(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "ansible",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.devcontainer/Dockerfile$"],
      "matchStrings": ["ansible-core==(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "ansible-core",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "kubectl and kubeadm share KUBECTL_VERSION; crictl minor tracks k8s minor — update as one PR",
      "matchPackageNames": ["kubernetes/kubernetes", "kubernetes-sigs/cri-tools"],
      "groupName": "kubernetes tools",
      "groupSlug": "kubernetes-tools"
    },
    {
      "description": "ansible meta-package and ansible-core must stay compatible — update together",
      "matchPackageNames": ["ansible", "ansible-core"],
      "groupName": "ansible",
      "groupSlug": "ansible"
    }
  ]
}
