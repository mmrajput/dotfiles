# =============================================================================
# DevContainer Shell Configuration
# Managed in: github.com/mmrajput/dotfiles
# =============================================================================

# kubectl completion + aliases
source <(kubectl completion bash)
alias k=kubectl
complete -o default -F __start_kubectl k

# Terraform tab completion
complete -C /usr/local/bin/terraform terraform

# Editor
export EDITOR=nvim
alias vi='nvim'
alias vim='nvim'

# Terraform / Terragrunt aliases
alias tf=terraform
alias tg=terragrunt
alias tgp='terragrunt plan'
alias tga='terragrunt apply'
alias tgr='terragrunt run-all'

# Terraform provider cache — shared across all stacks, avoids re-downloading on each init
export TF_PLUGIN_CACHE_DIR="$HOME/.config/terraform/plugin-cache"

# Useful aliases
alias ll='ls -alF'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'

# =============================================================================
# Prompt helpers
# =============================================================================

parse_git_branch() {
    git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

parse_k8s_context() {
    if [ -f ~/.kube/config ]; then
        ctx=$(kubectl config current-context 2>/dev/null)
        echo "⎈ ${ctx##*@}"
    fi
}

parse_az_account() {
    local profile="$HOME/.azure/azureProfile.json"
    if [ -f "$profile" ]; then
        local name
        name=$(jq -r '.subscriptions[] | select(.isDefault==true) | .name' "$profile" 2>/dev/null)
        [ -n "$name" ] && echo " ☁ ${name}"
    fi
}

# =============================================================================
# Colors
# =============================================================================

PURPLE='\[\033[0;35m\]'
CYAN='\[\033[0;36m\]'
YELLOW='\[\033[1;33m\]'
BLUE='\[\033[0;34m\]'
GREEN='\[\033[0;32m\]'
RED='\[\033[0;31m\]'
WHITE='\[\033[0;37m\]'
RESET='\[\033[0m\]'

# =============================================================================
# Two-line prompt:
#   ┌─[rajput@homelab-devcontainer]─[/workspaces/kubernetes-single-cluster]⎈ kubernetes(main)
#   └─$
# =============================================================================

PS1="${PURPLE}┌─[${CYAN}\u${WHITE}@${CYAN}\h${PURPLE}]─[${YELLOW}\w${PURPLE}]"
PS1="${PS1}${BLUE}\$(parse_k8s_context)${CYAN}\$(parse_az_account)${PURPLE}\$(parse_git_branch)${RESET}\n"
PS1="${PS1}${PURPLE}└─"
if [ $? -eq 0 ]; then
    PS1="${PS1}${GREEN}\$${RESET} "
else
    PS1="${PS1}${RED}\$${RESET} "
fi

export PS1
